///| API client for logging v2

///| Base URL: https://logging.googleapis.com

///|
pub struct LoggingService {
  base_url : String
  client : @core.GoogleClient
}

///|
pub fn LoggingService::new(
  client : @core.GoogleClient,
  base_url? : String = "https://logging.googleapis.com",
) -> LoggingService {
  LoggingService::{ base_url, client }
}

///|
/// DeleteLog
pub async fn LoggingService::delete_log(
  self : LoggingService,
  log_name : String,
) -> Json raise @http.HttpError {
  let path = "/" + "v2" + "/" + log_name
  let url = self.base_url + path
  let req = @http.HttpRequest::new(url, @http.HttpMethod::DELETE, {})
  let resp = self.client.request(req) catch { e => raise e }
  if resp.status_code >= 400 {
    raise @http.HttpError::network_message(
      "HTTP " + resp.status_code.to_string() + ": " + resp.body,
    )
  }
  let json = @json.parse(resp.body) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
  @json.from_json(json) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
}

///|
/// ListLogEntries
pub async fn LoggingService::list_log_entries(
  self : LoggingService,
  request : ListLogEntriesRequest,
) -> ListLogEntriesResponse raise @http.HttpError {
  let body = request.to_json().stringify()
  let h : Map[String, String] = {}
  h.set("Content-Type", "application/json")
  let path = "/" + "v2" + "/" + "entries:list"
  let url = self.base_url + path
  let req = @http.HttpRequest::new(
    url,
    @http.HttpMethod::POST,
    h,
    body=Some(body),
  )
  let resp = self.client.request(req) catch { e => raise e }
  if resp.status_code >= 400 {
    raise @http.HttpError::network_message(
      "HTTP " + resp.status_code.to_string() + ": " + resp.body,
    )
  }
  let json = @json.parse(resp.body) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
  @json.from_json(json) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
}

///|
/// ListLogs
pub async fn LoggingService::list_logs(
  self : LoggingService,
  parent : String,
  page_size? : Int? = None,
  page_token? : String? = None,
  resource_names? : Array[String]? = None,
) -> ListLogsResponse raise @http.HttpError {
  let qp : Array[(String, String)] = Array::new()
  match page_size {
    Some(v) => qp.push(("pageSize", v.to_string()))
    None => ()
  }
  match page_token {
    Some(v) => qp.push(("pageToken", url_encode(v)))
    None => ()
  }
  match resource_names {
    Some(vs) =>
      for v in vs {
        qp.push(("resourceNames", url_encode(v)))
      }
    None => ()
  }
  let qs = build_query_string(qp)
  let path = "/" + "v2" + "/" + parent + "/" + "logs"
  let url = if qs.is_empty() {
    self.base_url + path
  } else {
    self.base_url + path + "?" + qs
  }
  let req = @http.HttpRequest::new(url, @http.HttpMethod::GET, {})
  let resp = self.client.request(req) catch { e => raise e }
  if resp.status_code >= 400 {
    raise @http.HttpError::network_message(
      "HTTP " + resp.status_code.to_string() + ": " + resp.body,
    )
  }
  let json = @json.parse(resp.body) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
  @json.from_json(json) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
}

