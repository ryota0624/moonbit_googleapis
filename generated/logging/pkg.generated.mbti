pub(all) struct MetricDescriptor {
  metric_kind : String?
  value_type : String?
  metadata : MetricDescriptorMetadata?
  name : String?
  monitored_resource_types : Array[String]?
  labels : Array[LabelDescriptor]?
  description : String?
  type_ : String?
  display_name : String?
  launch_stage : String?
  unit : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct MetricDescriptorMetadata {
  launch_stage : String?
  time_series_resource_hierarchy_level : Array[String]?
  ingest_delay : String?
  sample_period : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct MonitoredResource {
  type_ : String?
  labels : Json?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct MonitoredResourceDescriptor {
  display_name : String?
  launch_stage : String?
  name : String?
  type_ : String?
  description : String?
  labels : Array[LabelDescriptor]?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct MonitoredResourceMetadata {
  system_labels : Json?
  user_labels : Json?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct Operation {
  name : String?
  done : Bool?
  metadata : Json?
  error : Status?
  response : Json?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct OpsAnalyticsQuery {
  sql_query_text : String?
  query_builder : QueryBuilderConfig?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct Policy {
  version : Int?
  etag : String?
  bindings : Array[Binding]?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct ProjectedField {
  field : String?
  truncation_granularity : String?
  cast : String?
  regex_extraction : String?
  sql_aggregation_function : FunctionApplication?
  operation : String?
  alias_ : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct QueryBuilderConfig {
  filter : FilterPredicate?
  field_sources : Array[FieldSource]?
  order_bys : Array[SortOrderParameter]?
  resource_names : Array[String]?
  limit : String?
  search_term : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct RecentQuery {
  logging_query : LoggingQuery?
  last_run_time : String?
  name : String?
  ops_analytics_query : OpsAnalyticsQuery?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct RequestLog {
  task_queue_name : String?
  instance_index : Int?
  line : Array[LogLine]?
  first : Bool?
  module_id : String?
  nickname : String?
  app_id : String?
  was_loading_request : Bool?
  mega_cycles : String?
  pending_time : String?
  status : Int?
  app_engine_release : String?
  ip : String?
  http_version : String?
  trace_sampled : Bool?
  latency : String?
  user_agent : String?
  start_time : String?
  version_id : String?
  referrer : String?
  host : String?
  instance_id : String?
  cost : Double?
  trace_id : String?
  finished : Bool?
  span_id : String?
  request_id : String?
  resource : String?
  response_size : String?
  end_time : String?
  method_ : String?
  source_reference : Array[SourceReference]?
  url_map_entry : String?
  task_name : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct SavedQuery {
  create_time : String?
  visibility : String?
  display_name : String?
  ops_analytics_query : OpsAnalyticsQuery?
  update_time : String?
  logging_query : LoggingQuery?
  name : String?
  description : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct SetIamPolicyRequest {
  policy : Policy?
  update_mask : String?
} derive(Eq, Show, ToJson, @json.FromJson)

pub(all) struct Settings {
  disable_default_sink : Bool?
  kms_key_name : String?
  storage_location : String?
  logging_service_account_id : String?
  default_sink_config : DefaultSinkConfig?
