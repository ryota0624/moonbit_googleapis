///| API client for pubsub v1

///| Base URL: https://pubsub.googleapis.com/

///|
pub(all) struct PubsubService {
  base_url : String
  access_token : String
}

///|
pub fn PubsubService::new(access_token : String) -> PubsubService {
  PubsubService::{ base_url: "https://pubsub.googleapis.com", access_token }
}

///|
fn PubsubService::auth_headers(self : PubsubService) -> Map[String, String] {
  {
    "Authorization": "Bearer " + self.access_token,
    "Accept": "application/json",
  }
}

///| pubsub.projects.schemas.commit

///|
/// Commits a new schema revision to an existing schema.
pub async fn PubsubService::projects_schemas_commit(
  self : PubsubService,
  client : &@http.HttpClient,
  name : String,
) -> Schema raise @http.HttpError {
  let meta : Map[String, Json] = Map::new()
  let body = Json::object(meta).stringify()
  let h = self.auth_headers()
  h.set("Content-Type", "application/json")
  let path = "/" + "v1" + "/" + name + "/" + ":commit"
  let url = self.base_url + path
  let req = @http.HttpRequest::new(
    url,
    @http.HttpMethod::POST,
    h,
    body=Some(body),
  )
  let resp = client.request(req) catch { e => raise e }
  if resp.status_code >= 400 {
    raise @http.HttpError::network_message(
      "HTTP " + resp.status_code.to_string() + ": " + resp.body,
    )
  }
  let json = @json.parse(resp.body) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
  @json.from_json(json) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
}

///| pubsub.projects.schemas.create

///|
/// Creates a schema.
pub async fn PubsubService::projects_schemas_create(
  self : PubsubService,
  client : &@http.HttpClient,
  parent : String,
  schema_id? : String? = None,
) -> Schema raise @http.HttpError {
  let qp : Array[(String, String)] = Array::new()
  match schema_id {
    Some(v) => qp.push(("schemaId", url_encode(v)))
    None => ()
  }
  let qs = build_query_string(qp)
  let meta : Map[String, Json] = Map::new()
  let body = Json::object(meta).stringify()
  let h = self.auth_headers()
  h.set("Content-Type", "application/json")
  let path = "/" + "v1" + "/" + parent + "/" + "schemas"
  let url = if qs.is_empty() {
    self.base_url + path
  } else {
    self.base_url + path + "?" + qs
  }
  let req = @http.HttpRequest::new(
    url,
    @http.HttpMethod::POST,
    h,
    body=Some(body),
  )
  let resp = client.request(req) catch { e => raise e }
  if resp.status_code >= 400 {
    raise @http.HttpError::network_message(
      "HTTP " + resp.status_code.to_string() + ": " + resp.body,
    )
  }
  let json = @json.parse(resp.body) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
  @json.from_json(json) catch {
    e => raise @http.HttpError::network_message(e.to_string())
  }
}

